# Copy to cluster/.env, or let cluster/gateway/setup-gateway.ps1 generate it with random values.
# CLUSTER_API_KEY: shared by every llama-server node; pass the same value to the Z13 and Mac installers.
CLUSTER_API_KEY=change-me
# LITELLM_MASTER_KEY: clients (ClearCase, smoke test) use this to call the gateway.
LITELLM_MASTER_KEY=sk-change-me
