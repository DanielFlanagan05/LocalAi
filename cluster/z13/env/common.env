# Shared settings for every llama-vision@ unit. Installed to /etc/llama-vision/common.env.
# Switch to the ROCm build after benchmarking: /opt/llama.cpp/b11216-rocm/bin/llama-server
LLAMA_SERVER=/opt/llama.cpp/b11216-vulkan/bin/llama-server
MODEL_DIR=/srv/models
API_KEY_FILE=/etc/llama-vision/api-key
